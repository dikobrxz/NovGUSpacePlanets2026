--- !u!114 &1400238633
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1400238632}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 833cfa7c0900e1c499af6587a23cdf40, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuizManager
  questionText: {fileID: 129109329}
  answerButtons:
  - {fileID: 1166887589}
  - {fileID: 1685536097}
  - {fileID: 1520840994}
  - {fileID: 1064133644}
  resultText: {fileID: 807956740}
  quizPanel: {fileID: 566981044}
  resultPanel: {fileID: 450549571}
  explanationText: {fileID: 527573826}
  continueButton: {fileID: 322353283}
  correctColor: {r: 0, g: 1, b: 0, a: 1}
  wrongColor: {r: 1, g: 0, b: 0, a: 1}
  defaultColor: {r: 1, g: 1, b: 1, a: 1}
  correctSound: {fileID: 8300000, guid: 6f48cffe63f293b4d8ab4cbea4a9eab8, type: 3}
  wrongSound: {fileID: 8300000, guid: 7102fc28923fbe3489c20b82b59358d7, type: 3}
  volume: 0.7
  finalVoiceOver: {fileID: 1400238635}
  questions:
  - text: "\u041A\u0430\u043A\u043E\u0439 \u043F\u043E \u0440\u0430\u0437\u043C\u0435\u0440\u0430\u043C
      \u041F\u043B\u0443\u0442\u043E\u043D?"
    answers:
    - "\u0421\u0430\u043C\u044B\u0439 \u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u0432 \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u0435"
    - "\u0411\u043E\u043B\u044C\u0448\u0435 \u043F\u043B\u0430\u043D\u0435\u0442\u044B
      \u0417\u0435\u043C\u043B\u044F"
    - "\u041C\u0435\u043D\u044C\u0448\u0435 \u041B\u0443\u043D\u044B"
    - "\u0422\u0430\u043A\u043E\u0439 \u0436\u0435, \u043A\u0430\u043A \u0421\u043E\u043B\u043D\u0446\u0435"
    correctIndex: 2
    explanation: "\u041F\u043B\u0443\u0442\u043E\u043D \u043C\u0435\u043D\u044C\u0448\u0435
      \u041B\u0443\u043D\u044B \u2014 \u0435\u0433\u043E \u0434\u0438\u0430\u043C\u0435\u0442\u0440
      \u0432\u0441\u0435\u0433\u043E 2377 \u043A\u043C, \u0430 \u0443 \u041B\u0443\u043D\u044B
      3475 \u043A\u043C."
  - text: "\u041A\u0430\u043A\u043E\u0439 \u043F\u0435\u0440\u0438\u043E\u0434 \u043E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u044F
      \u041F\u043B\u0443\u0442\u043E\u043D\u0430 \u0432\u043E\u043A\u0440\u0443\u0433
      \u0421\u043E\u043B\u043D\u0446\u0430?"
    answers:
    - "1 \u0433\u043E\u0434, \u043A\u0430\u043A \u0443 \u0417\u0435\u043C\u043B"
    - "100 \u0437\u0435\u043C\u043D\u044B\u0445 \u043B\u0435\u0442"
    - "200 \u0437\u0435\u043C\u043D\u044B\u0445 \u043B\u0435\u0442"
    - "\u043E\u043A\u043E\u043B\u043E 250 \u0437\u0435\u043C\u043D\u044B\u0445 \u043B\u0435\u0442"
    correctIndex: 3
    explanation: "\u041F\u043B\u0443\u0442\u043E\u043D \u0434\u0435\u043B\u0430\u0435\u0442
      \u043E\u0431\u043E\u0440\u043E\u0442 \u0432\u043E\u043A\u0440\u0443\u0433 \u0421\u043E\u043B\u043D\u0446\u0430
      \u0437\u0430 248 \u0437\u0435\u043C\u043D\u044B\u0445 \u043B\u0435\u0442."
  - text: "\u041F\u043B\u0443\u0442\u043E\u043D \u2014 \u043F\u043B\u0430\u043D\u0435\u0442\u0430
      \u0438\u043B\u0438 \u043D\u0435\u0442?"
    answers:
    - "\u0414\u0430"
    - "\u041D\u0435\u0442"
    - "\u041E\u0442\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u043A \u043A\u0430\u0440\u043B\u0438\u043A\u043E\u0432\u044B\u043C
      \u043F\u043B\u0430\u043D\u0435\u0442\u0430\u043C"
    correctIndex: 2
    explanation: "\u0421 2006 \u0433\u043E\u0434\u0430 \u041F\u043B\u0443\u0442\u043E\u043D
      \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F \u043A\u0430\u0440\u043B\u0438\u043A\u043E\u0432\u043E\u0439
      \u043F\u043B\u0430\u043D\u0435\u0442\u043E\u0439 \u043F\u043E \u0440\u0435\u0448\u0435\u043D\u0438\u044E
      \u041C\u0410\u0421."
  - text: "\u041F\u043E\u0441\u0435\u0449\u0430\u043B\u0438 \u043B\u0438 \u043B\u044E\u0434\u0438
      \u041F\u043B\u0443\u0442\u043E\u043D?"
    answers:
    - "\u0414\u0430 "
    - "\u041D\u0435\u0442"
    correctIndex: 1
    explanation: "\u041B\u044E\u0434\u0438 \u043D\u0438\u043A\u043E\u0433\u0434\u0430
      \u043D\u0435 \u0431\u044B\u043B\u0438 \u043D\u0430 \u041F\u043B\u0443\u0442\u043E\u043D\u0435.
      \u0411\u043B\u0438\u0436\u0435 \u0432\u0441\u0435\u0433\u043E \u043F\u043E\u0434\u043B\u0435\u0442\u0435\u043B
      \u0437\u043E\u043D\u0434 New Horizons \u0432 2015 \u0433\u043E\u0434\u0443."
  - text: "\u0415\u0441\u0442\u044C \u043B\u0438 \u0436\u0438\u0437\u043D\u044C \u043D\u0430
      \u041F\u043B\u0443\u0442\u043E\u043D\u0435?"
    answers:
    - "\u0414\u0430"
    - "\u041D\u0435\u0442"
    - "\u041A\u043E\u0433\u0434\u0430-\u0442\u043E \u0431\u044B\u043B\u0430"
    - "\u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u043D\u0430 \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u0430\u0445"
    correctIndex: 1
    explanation: "\u0422\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430
      -230\xB0C \u0438 \u0440\u0430\u0437\u0440\u0435\u0436\u0435\u043D\u043D\u0430\u044F
      \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0430 \u0434\u0435\u043B\u0430\u044E\u0442
      \u0436\u0438\u0437\u043D\u044C \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0439."
  lockPoint: {fileID: 942451165}
  playerRoot: {fileID: 1941153313}
