--- !u!114 &2038229764
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2038229762}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 40258e41c84e0834f851b9ad644a4723, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AudioManager
  voiceSource: {fileID: 578139610}
  sfxSource: {fileID: 273722239}
  uiManager: {fileID: 80716589}
  startText: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F, \u0434\u043E\u0440\u043E\u0433\u043E\u0439
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C,
    \u0442\u044B \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u0448\u044C\u0441\u044F
    \u0441 \u0448\u0435\u0441\u0442\u043E\u0439 \u043F\u043B\u0430\u043D\u0435\u0442\u043E\u0439
    \u043E\u0442 \u0421\u043E\u043B\u043D\u0446\u0430 \u0438 \u0432\u0442\u043E\u0440\u043E\u0439
    \u043F\u043E \u0432\u0435\u043B\u0438\u0447\u0438\u043D\u0435 \u043F\u043E\u0441\u043B\u0435
    \u042E\u043F\u0438\u0442\u0435\u0440\u0430."
  atmosphereFirstText: "\u0421\u0430\u0442\u0443\u0440\u043D \u043D\u0430\u0437\u0432\u0430\u043D
    \u0432 \u0447\u0435\u0441\u0442\u044C \u0440\u0438\u043C\u0441\u043A\u043E\u0433\u043E
    \u0411\u043E\u0433\u0430 \u0437\u0435\u043C\u043B\u0435\u0434\u0435\u043B\u0438\u044F.
    \u0412 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u043C \u043E\u043D \u0441\u043E\u0441\u0442\u043E\u0438\u0442
    \u0438\u0437 \u0432\u043E\u0434\u043E\u0440\u043E\u0434\u0430 \u0441 \u043F\u0440\u0438\u043C\u0435\u0441\u044F\u043C\u0438
    \u0433\u0435\u043B\u0438\u044F, \u0430 \u0442\u0430\u043A\u0436\u0435 \u0441\u043B\u0435\u0434\u0430\u043C\u0438
    \u0432\u043E\u0434\u044B, \u043C\u0435\u0442\u0430\u043D\u0430, \u0430\u043C\u043C\u0438\u0430\u043A\u0430
    \u0438 \u0431\u043E\u043B\u0435\u0435 \u0442\u044F\u0436\u0451\u043B\u044B\u0445
    \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u0432."
  atmosphereSecondText: "\u041F\u043E \u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044E
    \u0421\u0430\u0442\u0443\u0440\u043D, \u043A\u0430\u043A \u0438 \u042E\u043F\u0438\u0442\u0435\u0440,
    \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0433\u0430\u0437\u043E\u0432\u044B\u043C
    \u0433\u0438\u0433\u0430\u043D\u0442\u043E\u043C. \u041F\u0440\u0438 \u044D\u0442\u043E\u043C
    \u0432\u0435\u0442\u0440\u0430 \u043D\u0430 \u043D\u0451\u043C \u0432 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0440\u0430\u0437 \u0441\u0438\u043B\u044C\u043D\u0435\u0435. \u0427\u0435\u043B\u043E\u0432\u0435\u043A
    \u043D\u0435 \u0441\u043C\u043E\u0433 \u0431\u044B \u043F\u0440\u043E\u0436\u0438\u0442\u044C
    \u0437\u0434\u0435\u0441\u044C \u0438 \u0434\u043E\u043B\u0438 \u0441\u0435\u043A\u0443\u043D\u0434\u044B."
  observationFirstText: "\u0421\u0430\u0442\u0443\u0440\u043D \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F
    \u043E\u0442 \u0434\u0440\u0443\u0433\u0438\u0445 \u043F\u043B\u0430\u043D\u0435\u0442
    \u043F\u0440\u0435\u0436\u0434\u0435 \u0432\u0441\u0435\u0433\u043E \u0441\u0432\u043E\u0438\u043C\u0438
    \u043A\u043E\u043B\u044C\u0446\u0430\u043C\u0438. \u041F\u043E \u043E\u0434\u043D\u043E\u0439
    \u0438\u0437 \u0442\u0435\u043E\u0440\u0438\u0439, \u0432 \u0434\u0430\u043B\u0451\u043A\u043E\u043C
    \u043F\u0440\u043E\u0448\u043B\u043E\u043C \u0440\u044F\u0434\u043E\u043C \u0441
    \u043D\u0438\u043C \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E \u043A\u0440\u0443\u043F\u043D\u043E\u0435
    \u0441\u0442\u043E\u043B\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u0435, "
  observationSecondText: "\u043F\u043E\u0441\u043B\u0435 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
    \u0438 \u0441\u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043B\u0430\u0441\u044C
    \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u043A\u043E\u043B\u0435\u0446 \u0438
    \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432.
    \u041E\u0434\u0438\u043D \u0438\u0437 \u0441\u0430\u043C\u044B\u0445 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0445
    \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432 \u0421\u0430\u0442\u0443\u0440\u043D\u0430
    \u2014 \u0422\u0438\u0442\u0430\u043D, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u043F\u043E \u0440\u0430\u0437\u043C\u0435\u0440\u0430\u043C \u0434\u0430\u0436\u0435
    \u0431\u043E\u043B\u044C\u0448\u0435 \u041C\u0435\u0440\u043A\u0443\u0440\u0438\u044F."
  researchText: "\u0422\u0438\u0442\u0430\u043D - \u043E\u0434\u0438\u043D \u0438\u0437
    \u0441\u0430\u043C\u044B\u0445 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u0445
    \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432 \u0421\u043E\u043B\u043D\u0435\u0447\u043D\u043E\u0439
    \u0441\u0438\u0441\u0442\u0435\u043C\u044B. \u0412 \u043F\u0435\u0440\u0438\u043E\u0434
    \u0441 2004 \u043F\u043E 2017 \u0433\u043E\u0434 \u0441\u0430\u043C \u0421\u0430\u0442\u0443\u0440\u043D
    \u0438 \u0435\u0433\u043E \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u0438 \u0438\u0437\u0443\u0447\u0430\u043B
    \u0430\u043F\u043F\u0430\u0440\u0430\u0442 \"\u041A\u0430\u0441\u0441\u0438\u043D\u0438\"."
  questText: "\u0414\u0430\u0432\u0430\u0439 \u0432\u043E\u0437\u044C\u043C\u0451\u043C
    \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u0447\u0438\u043A \u0438 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u043C
    \u043D\u0430\u0441\u0442\u0440\u043E\u0438\u0442\u044C\u0441\u044F \u043D\u0430
    \u0447\u0430\u0441\u0442\u043E\u0442\u0443 \u043A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0430\u043F\u043F\u0430\u0440\u0430\u0442\u0430, \u0447\u0442\u043E\u0431\u044B
    \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u044C \u0434\u0430\u043D\u043D\u044B\u0435
    \u0441 \u043F\u043B\u0430\u043D\u0435\u0442\u044B - \u0433\u043E\u0434\u044B
    \u0435\u0451 \u0438\u0437\u0443\u0447\u0435\u043D\u0438\u044F \u0430\u043F\u043F\u0430\u0440\u0430\u0442\u043E\u043C
    \u201E\u041A\u0430\u0441\u0441\u0438\u043D\u0438\u201C."
  returnText: "\u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0442\u0435\u0431\u0435
    \u043C\u044B \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0438 \u044D\u0442\u0438
    \u0434\u0430\u043D\u043D\u044B\u0435 \u0443\u0447\u0451\u043D\u044B\u043C. \u0422\u0435\u043F\u0435\u0440\u044C
    \u043C\u044B \u043C\u043E\u0436\u0435\u043C \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
    \u043D\u0430 \u043A\u043E\u0440\u0430\u0431\u043B\u044C."
  quizGoodText: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u043D\u0430\u0448 \u044E\u043D\u044B\u0439
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C!
    \u0422\u0432\u043E\u0438\u0445 \u0437\u043D\u0430\u043D\u0438\u0439 \u0443\u0436\u0435
    \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E, \u0447\u0442\u043E\u0431\u044B
    \u043F\u043E\u043C\u043E\u0447\u044C \u0443\u0447\u0451\u043D\u044B\u043C \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043E\u0432\u0430\u0442\u044C
    \u043D\u043E\u0432\u0443\u044E \u043C\u0438\u0441\u0441\u0438\u044E \u043F\u043E
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044E \u0421\u0430\u0442\u0443\u0440\u043D\u0430."
  quizBadText: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u044E\u043D\u044B\u0439
    \u0434\u0440\u0443\u0433! \u0414\u0443\u043C\u0430\u044E, \u043D\u0430\u043C
    \u0441\u0442\u043E\u0438\u0442 \u0435\u0449\u0451 \u0440\u0430\u0437 \u043F\u043E\u0441\u0435\u0442\u0438\u0442\u044C
    \u0421\u0430\u0442\u0443\u0440\u043D, \u0447\u0442\u043E\u0431\u044B \u0443\u0437\u043D\u0430\u0442\u044C
    \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0431\u043E\u043B\u044C\u0448\u0435."
  quizPerfectText: "\u042D\u0442\u043E \u043D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u044B\u0439
    \u0443\u0441\u043F\u0435\u0445 \u043D\u0430\u0448\u0435\u0433\u043E \u0441 \u0442\u043E\u0431\u043E\u0439
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F \u0421\u0430\u0442\u0443\u0440\u043D\u0430!
    \u0422\u0432\u043E\u0438 \u0437\u043D\u0430\u043D\u0438\u044F \u043F\u043E\u043C\u043E\u0433\u0443\u0442
    \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u0442\u0432\u0443 \u0443\u0437\u043D\u0430\u0442\u044C
    \u0431\u043E\u043B\u044C\u0448\u0435 \u043E \u043D\u0430\u0448\u0435\u0439 \u0421\u043E\u043B\u043D\u0435\u0447\u043D\u043E\u0439
    \u0441\u0438\u0441\u0442\u0435\u043C\u0435."
  endText: "\u041D\u0443 \u0447\u0442\u043E \u0436, \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043C\u0441\u044F
    \u0432 \u043D\u043E\u0432\u043E\u0435 \u043F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435."
  startClip: {fileID: 8300000, guid: 0d90b433e9ef09943894fccadf62ea87, type: 3}
  atmosphereClip: {fileID: 8300000, guid: 83a05ac79b6df9b4191aad7b699e98c4, type: 3}
