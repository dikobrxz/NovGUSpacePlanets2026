  - {fileID: 591151172}
  correctAnswersText: {fileID: 694830163}
  wrongAnswersText: {fileID: 69955663}
  firstQuestionText: "\u041A\u0430\u043A\u043E\u0439 \u043F\u043E \u0440\u0430\u0437\u043C\u0435\u0440\u0430\u043C
    \u0421\u0430\u0442\u0443\u0440\u043D?"
  firstQuestionFirstAnswerText: "\u0421\u0430\u043C\u044B\u0439 \u0431\u043E\u043B\u044C\u0448\u043E\u0439
    \u0432 \u0421\u043E\u043B\u043D\u0435\u0447\u043D\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u0435"
  firstQuestionSecondAnswerText: "\u0412\u0442\u043E\u0440\u043E\u0439 \u043F\u043E
    \u0440\u0430\u0437\u043C\u0435\u0440\u0430\u043C"
  firstQuestionThirdAnswerText: "\u0422\u0440\u0435\u0442\u0438\u0439 \u043F\u043E
    \u0440\u0430\u0437\u043C\u0435\u0440\u0430\u043C"
  secondQuestionText: "\u041A\u0430\u043A \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
    \u043E\u0434\u0438\u043D \u0438\u0437 \u0441\u0430\u043C\u044B\u0445 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0445
    \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432 \u0421\u0430\u0442\u0443\u0440\u043D\u0430?"
  secondQuestionFirstAnswerText: "\u041C\u0435\u0440\u043A\u0443\u0440\u0438\u0439"
  secondQuestionSecondAnswerText: "\u0422\u0438\u0442\u0430\u043D"
  secondQuestionThirdAnswerText: "\u041B\u0443\u043D\u0430"
  secondQuestionFourthAnswerText: "\u0421\u0430\u0442\u0443\u0440\u043D"
  thirdQuestionText: "\u041D\u0430 \u043A\u0430\u043A\u043E\u0439 \u043F\u043B\u0430\u043D\u0435\u0442\u0435
    \u0434\u0443\u044E\u0442 \u043E\u0447\u0435\u043D\u044C \u0441\u0438\u043B\u044C\u043D\u044B\u0435
    \u0432\u0435\u0442\u0440\u0430?"
  thirdQuestionFirstAnswerText: "\u042E\u043F\u0438\u0442\u0435\u0440"
  thirdQuestionSecondAnswerText: "\u0421\u0430\u0442\u0443\u0440\u043D"
  thirdQuestionThirdAnswerText: "\u0417\u0435\u043C\u043B\u044F"
  thirdQuestionFourthAnswerText: "\u041C\u0430\u0440\u0441"
  fourthQuestionText: "\u041F\u043E\u0441\u0435\u0449\u0430\u043B\u0438 \u043B\u0438
    \u043B\u044E\u0434\u0438 \u043F\u043B\u0430\u043D\u0435\u0442\u0443?"
  fourthQuestionFirstAnswerText: "\u0414\u0430"
  fourthQuestionSecondAnswerText: "\u041D\u0435\u0442"
  fifthQuestionText: "\u0415\u0441\u0442\u044C \u043B\u0438 \u0436\u0438\u0437\u043D\u044C
    \u043D\u0430 \u0421\u0430\u0442\u0443\u0440\u043D\u0435?"
  fifthQuestionFirstAnswerText: "\u0414\u0430"
  fifthQuestionSecondAnswerText: "\u041D\u0435\u0442"
  fifthQuestionThirdAnswerText: "\u041A\u043E\u0433\u0434\u0430-\u0442\u043E \u0431\u044B\u043B\u0430"
  fifthQuestionFourthAnswerText: "\u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u043D\u0430 \u0435\u0433\u043E
    \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u0430\u0445"
  correctText: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E: "
  wrongText: "\u041E\u0448\u0438\u0431\u043A\u0438: "
  audioSource: {fileID: 1151298532}
