--- !u!114 &705081757
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 705081755}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c9fd08f2eec321545af3ebdbd1ba7703, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EarthQuizManager
  currentStage: 0
  questions:
  - question: "\u041A\u0430\u043A\u0430\u044F \u043F\u043B\u0430\u043D\u0435\u0442\u0430
      \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043D\u0430\u0448\u0438\u043C
      \u0434\u043E\u043C\u043E\u043C?"
    answers:
    - "\u0417\u0435\u043C\u043B\u044F"
    - "\u041C\u0430\u0440\u0441"
    - "\u0412\u0435\u043D\u0435\u0440\u0430"
    - "\u042E\u043F\u0438\u0442\u0435\u0440"
    correctAnswerIndex: 0
    explanation: "\u0417\u0435\u043C\u043B\u044F \u2014 \u0442\u0440\u0435\u0442\u044C\u044F
      \u043F\u043B\u0430\u043D\u0435\u0442\u0430 \u043E\u0442 \u0421\u043E\u043B\u043D\u0446\u0430
      \u0438 \u043D\u0430\u0448 \u0434\u043E\u043C."
  - question: "\u0427\u0442\u043E \u043F\u043E\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0431\u043E\u043B\u044C\u0448\u0443\u044E \u0447\u0430\u0441\u0442\u044C \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
      \u0417\u0435\u043C\u043B\u0438?"
    answers:
    - "\u041F\u0443\u0441\u0442\u044B\u043D\u0438"
    - "\u0412\u043E\u0434\u0430"
    - "\u041B\u0451\u0434"
    - "\u0413\u043E\u0440\u044B"
    correctAnswerIndex: 1
    explanation: "\u0411\u043E\u043B\u044C\u0448\u0443\u044E \u0447\u0430\u0441\u0442\u044C
      \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u0417\u0435\u043C\u043B\u0438
      \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442 \u0432\u043E\u0434\u0430."
  - question: "\u041A\u0430\u043A\u0430\u044F \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0430
      \u0417\u0435\u043C\u043B\u0438 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442
      \u0432\u043E\u0437\u0434\u0443\u0445, \u043A\u043E\u0442\u043E\u0440\u044B\u043C
      \u043C\u044B \u0434\u044B\u0448\u0438\u043C?"
    answers:
    - "\u041B\u0438\u0442\u043E\u0441\u0444\u0435\u0440\u0430"
    - "\u0410\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0430"
    - "\u042F\u0434\u0440\u043E"
    - "\u041C\u0430\u043D\u0442\u0438\u044F"
    correctAnswerIndex: 1
    explanation: "\u0410\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0430 \u2014 \u0433\u0430\u0437\u043E\u0432\u0430\u044F
      \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0430 \u0417\u0435\u043C\u043B\u0438."
  - question: "\u041F\u043E\u0447\u0435\u043C\u0443 \u043D\u0430 \u0417\u0435\u043C\u043B\u0435
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u0430 \u0436\u0438\u0437\u043D\u044C?"
    answers:
    - "\u0415\u0441\u0442\u044C \u0432\u043E\u0434\u0430, \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0430
      \u0438 \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0430\u044F \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430"
    - "\u0417\u0435\u043C\u043B\u044F \u0441\u0430\u043C\u0430\u044F \u0431\u043E\u043B\u044C\u0448\u0430\u044F
      \u043F\u043B\u0430\u043D\u0435\u0442\u0430"
    - "\u0417\u0435\u043C\u043B\u044F \u043D\u0435 \u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F"
    - "\u041D\u0430 \u0417\u0435\u043C\u043B\u0435 \u043D\u0435\u0442 \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u0438"
    correctAnswerIndex: 0
    explanation: "\u0416\u0438\u0437\u043D\u0438 \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0442
      \u0432\u043E\u0434\u0430, \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0430
      \u0438 \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0430\u044F \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430."
  titleText: {fileID: 626777713}
  instructionText: {fileID: 1907690063}
